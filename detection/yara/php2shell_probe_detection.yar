
// ---------------------------------------------------------------------------
// Rule 7: PHP2Shell Probe Traffic PCAP Pattern
// Detects the nested-array multipart probe pattern in captured network traffic
// or HTTP body logs. Matches the 62-level array key structure.
// ---------------------------------------------------------------------------

rule PHP2Shell_Active_Probe_Traffic
{
    meta:
        description   = "Detects PHP2Shell active probe traffic patterns (differential-analysis)"
        author        = "PHP2Shell Research – Defensive Detection Team"
        date          = "2026-10-22"
        version       = "2.0"
        reference     = "CVE-2026-109618, CVE-2026-109619"
        severity      = "high"
        tlp           = "white"

    strings:
        // differential-analysis nested array key pattern: field[a][a][a]...
        $nested_re     = /field(\[.{1,5}\]){30,}/ ascii wide
        $nested_literal = "field[a][a][a][a][a][a][a][a][a][a]" ascii

        // PHP_SESSION_UPLOAD_PROGRESS in multipart body (CVE-2026-109619 vector)
        $upload_prog   = "PHP_SESSION_UPLOAD_PROGRESS" ascii wide

        // PHP2Shell scanner tool boundary strings
        $boundary1     = "----PHP2ShellProbe" ascii wide
        $boundary2     = "----PHP2ShellUploadProbe" ascii wide
        $boundary3     = "----PHP2ShellWAFTest" ascii wide
        $boundary4     = "PHP2Shell-Scanner" ascii wide

        // php2shell-research scanner specific boundary
        $php2shell-research_bnd = /----[A-Za-z0-9]{16,}/ ascii

        // Content-Type with boundary AND large Content-Length combo
        $ct_multipart  = "multipart/form-data" ascii wide
        $large_cl      = /Content-Length:\s*(1[0-9]{7}|[2-9][0-9]{7})/ ascii  // >= 10MB

    condition:
        (
            // Direct PHP2Shell tool identification
            any of ($boundary*)
            or
            // Nested array probe pattern
            ($nested_re or $nested_literal)
            or
            // Upload progress abuse
            ($upload_prog and $ct_multipart)
            or
            // Large multipart POST (heuristic for payload escalation)
            ($ct_multipart and $large_cl)
        )
}


// ---------------------------------------------------------------------------
// Rule 8: PHP2Shell Differential Probe Response Pattern
// Matches HTTP 500 error pages generated by PHP-FPM worker crashes triggered
// by the exploit. Useful for hunting in proxy/WAF response body logs.
// ---------------------------------------------------------------------------

rule PHP2Shell_Worker_Crash_Response
{
    meta:
        description   = "Detects PHP-FPM crash HTTP responses following php2shell probes"
        author        = "PHP2Shell Research – Defensive Detection Team"
        date          = "2026-10-22"
        version       = "2.0"
        reference     = "CVE-2026-109618, CVE-2026-109619"
        severity      = "high"
        tlp           = "white"

    strings:
        // Generic PHP-FPM upstream error strings
        $fpm_err1      = "502 Bad Gateway" ascii wide nocase
        $fpm_err2      = "An error occurred" ascii wide nocase
        $fpm_err3      = "502 - Bad Gateway" ascii wide nocase
        $fpm_err4      = "upstream prematurely closed connection" ascii wide nocase
        $fpm_err5      = "connect() failed" ascii wide nocase
        $fpm_err6      = "recv() failed" ascii wide nocase

        // Nginx upstream error (PHP-FPM crash manifest)
        $nginx_err1    = "no live upstreams while connecting to upstream" ascii
        $nginx_err2    = "upstream sent invalid header while reading response header" ascii

        // Apache mod_fcgid crash responses
        $apache_err    = "premature end of script headers" ascii

        // PHP fatal error in response body (sometimes leaked)
        $php_fatal1    = "Fatal error" ascii wide
        $php_fatal2    = "zend_mm_heap corrupted" ascii wide
        $php_fatal3    = "Segmentation fault" ascii wide
        $php_fatal4    = "Allowed memory size" ascii wide

    condition:
        filesize < 50KB and
        (
            (2 of ($fpm_err*))
            or
            (1 of ($nginx_err*))
            or
            ($apache_err and 1 of ($php_fatal*))
            or
            (2 of ($php_fatal*))
        )
}

